# Salin ke frontend/.env.local lalu sesuaikan nilainya.

# Base URL backend API (dibaca di lib/api.ts). Default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL situs untuk metadata (Open Graph, dsb). Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host gambar eksternal yang diizinkan next/image (daftar hostname dipisah
# koma). Kosongkan bila semua gambar disajikan lokal dari /public/images.
# Contoh: images.example.com,cdn.example.com
IMAGE_REMOTE_HOSTS=
