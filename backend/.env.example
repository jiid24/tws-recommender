# Salin ke backend/.env lalu sesuaikan nilainya.

# Koneksi MongoDB
MONGODB_URL=mongodb://localhost:27017/
DB_NAME=tws_recommender
COLLECTION_NAME=tws_products

# Origin frontend yang diizinkan mengakses API (CORS).
# Beberapa origin dipisah koma. Untuk produksi ganti ke domain frontend.
# Contoh: http://localhost:3000,https://tws.example.com
CORS_ORIGINS=http://localhost:3000
